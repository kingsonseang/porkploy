# Server
PORT=3000
VITE_CONTROL_PLANE_URL=http://localhost:3001

# Database (same Postgres instance, Better Auth needs it)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/porkploy

# Better Auth
BETTER_AUTH_SECRET=your-secret-min-32-chars   # must match control plane
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth App (for Better Auth social login — different from GitHub App for deployments)
GITHUB_CLIENT_ID=your-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-oauth-app-client-secret
