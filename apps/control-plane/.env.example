# Server
PORT=3001
DASHBOARD_URL=http://localhost:3000

# Database (Postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/porkploy

# Nomad
NOMAD_ADDR=http://127.0.0.1:4646
NOMAD_TOKEN=your-control-plane-nomad-token

# BuildKit
BUILDKIT_ADDR=tcp://127.0.0.1:8372

# GitHub App
GITHUB_APP_ID=your-app-id
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_PRIVATE_KEY_PATH= # add private key as .pem `~/tmp/porkploy-dev/env/github-app.pem`
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# GHCR
GHCR_ORG=your-github-org

# Infisical (platform machine identity)
INFISICAL_CLIENT_ID=your-client-id
INFISICAL_CLIENT_SECRET=your-client-secret

# Better Auth (shared secret for session validation)
BETTER_AUTH_SECRET=your-secret-min-32-chars

# Encryption key for Infisical workspace credentials stored in DB
ENCRYPTION_KEY=your-32-byte-hex-key
